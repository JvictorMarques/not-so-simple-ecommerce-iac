data "archive_file" "node_modules" {
  type        = "zip"
  source_dir  = "${path.module}/lambdas/layers/dependencies"
  output_path = "${path.module}/lambdas/order-confirmed/outputs/node_modules.zip"
}

resource "aws_lambda_layer_version" "order_confirmed_node_modules" {
  layer_name       = "${var.lambda.name}-node-modules"
  filename         = data.archive_file.node_modules.output_path
  source_code_hash = data.archive_file.node_modules.output_base64sha256

  compatible_runtimes = [var.lambda.runtime]
}
